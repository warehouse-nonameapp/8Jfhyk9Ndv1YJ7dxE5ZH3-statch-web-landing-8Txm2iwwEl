---
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || "uk";
const t = useTranslations(lang as any);
---

<div
    class="relative w-full rounded-[32px] border-[2px] border-[#1F1B30] bg-[#17132C] overflow-hidden mt-[140px]"
>
    <div
        class="absolute inset-x-0 bottom-0 top-0 bg-gradient-to-r from-[#17132C] to-[#1E1939]"
    >
    </div>

    {/* Background Image Logic */}
    <picture
        class="absolute bottom-0 right-0 z-0 select-none pointer-events-none"
    >
        <source
            media="(max-width: 768px)"
            srcset={import.meta.env.BASE_URL +
                "assets/ic_beta_background_mobile.svg"}
        />
        <img
            src={import.meta.env.BASE_URL +
                "assets/ic_beta_background_desktop.svg"}
            alt=""
            loading="lazy"
            class="h-auto w-full object-bottom object-right"
        />
    </picture>

    <div
        class="relative z-10 px-6 py-8 md:px-[56px] md:py-[48px] flex flex-col md:flex-row items-center gap-10 md:gap-[46px]"
    >
        <div class="flex flex-col gap-4 self-stretch flex-[2]">
            <h3
                class="self-stretch text-[#E0E0E0] text-2xl md:text-[32px] font-extrabold leading-[130%] tracking-[1px] font-sans tabular-nums lining-nums"
            >
                {t("beta_banner_title")}
            </h3>
            <p
                class="self-stretch text-[#E0E0E0] text-sm md:text-base font-semibold leading-[150%] font-sans tabular-nums lining-nums opacity-80"
            >
                {t("beta_banner_description")}
            </p>
        </div>
        <div class="w-full md:w-auto flex-1 origin-center flex justify-center md:justify-end">
            <BetaSubscriptionButton client:visible className="whitespace-nowrap w-full md:w-auto" />
        </div>
    </div>
</div>
