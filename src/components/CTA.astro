---
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import { Strings } from "../consts/strings";
---

<section
    class="relative z-30 -mt-[24px] md:-mt-[40px] overflow-hidden"
    style="border-radius: 40px 40px 0 0; background: linear-gradient(180deg, #0D0E10 0%, #14161A 97.932%);"
>
    {/* Footer background SVG */}
    <img
        src={import.meta.env.BASE_URL + "assets/ic_footer_background.svg"}
        alt=""
        aria-hidden="true"
        class="absolute pointer-events-none hidden md:block"
        style="bottom: 100px; left: 200px; right: 120px; width: calc(100% - 320px); height: auto;"
    />

    {/* Dot-grid decorations (left and right) */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        {/* Left grid */}
        <div class="absolute left-0 top-0 bottom-0 w-[200px] md:w-[280px] opacity-[0.07]"
            style="background-image: radial-gradient(circle, #1C4FD8 1px, transparent 1px); background-size: 40px 40px;"
        />
        {/* Right grid */}
        <div class="absolute right-0 top-0 bottom-0 w-[200px] md:w-[280px] opacity-[0.07]"
            style="background-image: radial-gradient(circle, #1C4FD8 1px, transparent 1px); background-size: 40px 40px;"
        />
    </div>

    {/* Content */}
    <div
        class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] py-[80px] md:py-[100px] flex flex-col items-center text-center"
    >
        <h2
            data-i18n="cta_title"
            class="font-['Mulish'] text-[28px] leading-[40px] md:text-[48px] md:leading-[64px] font-extrabold tracking-[0.5px] text-white text-center mb-[16px] animate-on-scroll max-w-[800px]"
            style="font-variant-numeric: lining-nums tabular-nums;"
        >
            {Strings.cta_title}
        </h2>

        <p
            data-i18n="cta_description"
            class="font-['Mulish'] text-[14px] leading-[150%] md:text-[16px] font-semibold text-white text-center max-w-[770px] mb-[48px] animate-on-scroll delay-100"
            style="font-variant-numeric: lining-nums tabular-nums;"
        >
            {Strings.cta_description}
        </p>

        <div class="w-full flex justify-center animate-on-scroll delay-200">
            <BetaSubscriptionButton
                client:visible
                className="w-full max-w-[280px] h-[56px] !py-0 md:w-auto md:h-auto md:!py-[20px] md:max-w-none"
            />
        </div>
    </div>
</section>
