---
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import { Strings } from "../consts/strings";
---

<section
    class="relative z-30 -mt-[24px] md:-mt-[40px] overflow-hidden rounded-t-[24px] md:rounded-t-[40px]"
    style="background: #14161A;"
>

    {/* Dot-grid decorations (left and right) */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        {/* Left grid */}
        <div class="absolute left-0 top-0 bottom-0 w-[200px] md:w-[280px] opacity-[0.07]"
            style="background-image: radial-gradient(circle, #1C4FD8 1px, transparent 1px); background-size: 40px 40px;"
        />
        {/* Right grid */}
        <div class="absolute right-0 top-0 bottom-0 w-[200px] md:w-[280px] opacity-[0.07]"
            style="background-image: radial-gradient(circle, #1C4FD8 1px, transparent 1px); background-size: 40px 40px;"
        />
    </div>

    {/* Content */}
    <div
        class="relative z-10 max-w-[1440px] mx-auto px-5 md:px-[80px] lg:px-[140px] xl:px-[200px] pt-8 md:pt-[100px] pb-0 md:pb-0 flex flex-col items-center text-center"
    >
        <h2
            data-i18n="cta_title"
            class="font-['Mulish'] text-[32px] leading-[120%] md:text-[48px] md:leading-[64px] font-extrabold md:tracking-[0.5px] text-[#E0E0E0] text-center mb-6 md:mb-[16px] animate-on-scroll max-w-[800px]"
            style="font-variant-numeric: lining-nums tabular-nums;"
        >
            {Strings.cta_title}
        </h2>

        <p
            data-i18n="cta_description"
            class="font-['Mulish'] text-[16px] leading-[150%] font-extrabold md:font-semibold text-[#E0E0E0] text-center max-w-[770px] mb-10 md:mb-[48px] animate-on-scroll delay-100"
            style="font-variant-numeric: lining-nums tabular-nums;"
        >
            {Strings.cta_description}
        </p>

        <div id="cta-anchor" class="w-full flex justify-center animate-on-scroll delay-200">
            <BetaSubscriptionButton
                client:visible
                className="md:w-auto md:h-auto md:!py-[20px] md:!px-[40px]"
            />
        </div>
    </div>

    {/* Mobile footer image */}
    <div class="block md:hidden w-full mt-10 px-5">
        <img
            src={import.meta.env.BASE_URL + "assets/ic_footer_background_mobile.svg"}
            alt=""
            aria-hidden="true"
            class="w-full h-auto block pointer-events-none"
        />
    </div>

    {/* Desktop footer image */}
    <div class="hidden md:block w-full max-w-[1440px] mx-auto px-[80px] lg:px-[140px] xl:px-[200px]">
        <img
            src={import.meta.env.BASE_URL + "assets/ic_footer_background.svg"}
            alt=""
            aria-hidden="true"
            class="w-full h-auto block pointer-events-none"
        />
    </div>
</section>
