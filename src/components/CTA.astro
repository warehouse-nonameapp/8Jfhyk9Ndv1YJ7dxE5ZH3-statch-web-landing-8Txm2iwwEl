---
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import { Strings } from "../consts/strings";
---

<section
    class="bg-gradient-to-b from-[#0D0E10] to-[#161822] overflow-hidden relative rounded-t-[24px] md:rounded-t-[40px] z-30 -mt-[24px] md:-mt-[40px]"
>
    {/* Background Image/Gradient Replacement */}
    <div
        class="absolute inset-x-0 bottom-0 z-0 h-full flex items-end justify-center pointer-events-none"
    >
        <picture class="w-full flex items-end justify-center">
            <img
                src="/assets/ic_footer_radial_background.webp"
                alt=""
                class="w-full h-auto object-bottom object-cover md:object-contain opacity-60"
            />
        </picture>
    </div>

    {/* Content */}
    <div
        class="relative z-10 max-w-[1200px] mx-auto px-6 md:px-10 pt-8 md:pt-[100px] pb-8 md:pb-32 flex flex-col items-center text-center text-white"
    >
        <h2
            class="self-stretch text-[#E0E0E0] text-center text-3xl md:text-[48px] font-extrabold leading-[130%] tracking-[1px] font-sans tabular-nums lining-nums mb-6 animate-on-scroll"
        >
            {Strings.cta_title}
        </h2>

        <p
            class="self-stretch text-[#E0E0E0] text-sm md:text-base font-semibold leading-[150%] tabular-nums lining-nums opacity-80 max-w-2xl mb-12 animate-on-scroll delay-100"
        >
            {Strings.cta_description}
        </p>

        <div class="w-full flex justify-center animate-on-scroll delay-200">
            <BetaSubscriptionButton
                client:visible
                className="w-full max-w-[256px] h-[56px] !py-0 md:w-auto md:h-auto md:!py-[20px] md:max-w-none"
            />
        </div>
    </div>
</section>
