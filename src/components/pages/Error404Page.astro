---
import Layout from "../../layouts/Layout.astro";
import AppLogo from "../header/AppLogo.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
    lang: "uk" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<Layout titleEn="Statch | Page not found" titleUk="Statch | Сторінку не знайдено">
	<main class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden bg-gradient-light px-4">
		<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-error opacity-10 rounded-full blur-[120px] animate-pulse-glow"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-error opacity-10 rounded-full blur-[120px] animate-pulse-glow delay-500"></div>

		<div class="z-10 flex flex-col items-center text-center max-w-2xl animate-on-scroll">
			<div class="mb-12 scale-125">
				<AppLogo />
			</div>
			
			<div class="text-[120px] leading-none font-extrabold text-error opacity-20 mb-4 tracking-tighter">404</div>

			<h1 class="text-3xl md:text-5xl font-extrabold text-text-main mb-6 tracking-tight leading-tight">
				{t("error_404_title")}
			</h1>
			
			<p class="text-lg md:text-xl text-text-gray mb-10 leading-relaxed max-w-lg mx-auto">
				{t("error_404_desc")}
			</p>

			<a href={lang === "en" ? "/en" : "/"} class="btn-gradient-border bg-[#1C4FD8] hover:bg-[#1946BF] active:bg-[#143899] text-white font-['Mulish'] font-semibold text-[16px] leading-[150%] py-4 px-8 md:py-[20px] md:px-[40px] rounded-[12px] md:rounded-[16px] transition-all shadow-sm active:scale-[0.98] flex items-center justify-center text-center">
				<span>{t("back_to_home")}</span>
			</a>
		</div>
	</main>
</Layout>
