---
interface Props {
    darkText?: boolean;
}

const { darkText = false } = Astro.props;
---

<a href="/" class="flex items-center gap-[8px] md:gap-[10px]" aria-label="Statch — повернутись на головну">
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_icon.svg"}
        alt="Statch Icon"
        class="w-[20px] h-[20px] md:w-[24px] md:h-[24px]"
    />
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_name.svg"}
        alt="Statch"
        class="h-[18px] md:h-[21px]"
    />
</a>
