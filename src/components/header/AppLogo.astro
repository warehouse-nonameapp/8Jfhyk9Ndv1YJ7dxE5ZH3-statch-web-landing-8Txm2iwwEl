---
const lang = Astro.currentLocale || "uk";
const homeUrl = lang === "en" ? "/en/" : "/";
const ariaLabel = lang === "en" ? "Statch — back to home" : "Statch — повернутись на головну";
---

<a href={homeUrl} class="flex items-center gap-2 md:gap-[10px]" aria-label={ariaLabel}>
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_icon.svg"}
        alt="Statch Icon"
        class="w-5 h-5 md:w-[24px] md:h-[24px] shrink-0"
        draggable="false"
        style="user-select: none; -webkit-user-drag: none;"
    />
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_name.svg"}
        alt="Statch"
        class="w-[64px] h-[17.64px] md:w-auto md:h-[21px]"
        draggable="false"
        style="user-select: none; -webkit-user-drag: none;"
    />
</a>
