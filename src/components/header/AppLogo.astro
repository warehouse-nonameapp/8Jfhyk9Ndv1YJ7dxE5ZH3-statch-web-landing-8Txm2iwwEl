---
interface Props {
    darkText?: boolean;
}

const { darkText = false } = Astro.props;
---

<a href="/" class="flex items-center gap-[10px]" aria-label="Statch — повернутись на головну">
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_icon.svg"}
        alt="Statch Icon"
        class="w-[24px] h-[24px] shrink-0"
    />
    <img
        src={import.meta.env.BASE_URL + "assets/ic_statch_name.svg"}
        alt="Statch"
        class="h-[21px]"
    />
</a>
