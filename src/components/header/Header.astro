---
import AppLogo from "./AppLogo.astro";


// Compute locale routes
const currentLocale = Astro.currentLocale || "uk";
const pathname = Astro.url.pathname;
const cleanPathname = pathname.replace(/^\/en/, '');
const ukUrl = cleanPathname === '' ? '/' : cleanPathname;
const enUrl = '/en' + (cleanPathname === '/' ? '/' : cleanPathname);
---

<div class="w-full flex items-center">
    {/* Left: Logo */}
    <div class="flex-1">
        <AppLogo />
    </div>

    {/* Right: Language switcher */}
    <div
        class="flex-1 flex items-center justify-end gap-[16px]"
        id="lang-switcher"
        style="font-variant-numeric: lining-nums tabular-nums;"
    >
        <a
            href={ukUrl}
            class="font-['Mulish'] text-[16px] font-semibold leading-[150%] transition-colors duration-200"
            style={{ color: currentLocale === 'uk' ? '#090924' : '#B2BACF' }}
            aria-current={currentLocale === 'uk' ? "page" : undefined}
            aria-label="Switch to Ukrainian"
        >
            Укр
        </a>
        <a
            href={enUrl}
            class="font-['Mulish'] text-[16px] font-semibold leading-[150%] transition-colors duration-200"
            style={{ color: currentLocale === 'en' ? '#090924' : '#B2BACF' }}
            aria-current={currentLocale === 'en' ? "page" : undefined}
            aria-label="Switch to English"
        >
            Eng
        </a>
    </div>
</div>
