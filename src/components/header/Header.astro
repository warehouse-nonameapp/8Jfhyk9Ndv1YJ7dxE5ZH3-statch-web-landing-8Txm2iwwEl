---
import AppLogo from "./AppLogo.astro";
import PlatformChipsRow from "./PlatformChipsRow.astro";

interface Props {
    darkText?: boolean;
}

const { darkText = false } = Astro.props;
---

<div
    class="w-full flex justify-between items-center"
>
    <AppLogo darkText={darkText} />
    <PlatformChipsRow darkText={darkText} />
</div>
