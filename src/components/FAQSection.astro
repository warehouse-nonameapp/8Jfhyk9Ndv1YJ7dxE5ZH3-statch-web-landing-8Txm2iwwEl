---
import { getEntry } from "astro:content";
import { FAQList } from "./islands/FAQList";

const faqEntry = await getEntry("faq", "all");
const faqData = faqEntry?.data || [];
---

<section
    class="faq-mobile-bg bg-white relative z-20 -mt-[24px] md:-mt-[40px] rounded-t-[24px] md:rounded-t-[40px]"
    style="padding-top: 80px; padding-bottom: 80px;"
>
    <div class="max-w-[1440px] mx-auto px-5 md:px-[80px] lg:px-[140px] xl:px-[200px]">
        <h2
            class="text-[#090924] text-[24px] md:text-[32px] font-extrabold leading-[130%] font-sans tabular-nums lining-nums mb-4 md:mb-[40px] animate-on-scroll"
        >
            Часто питають, тож відповідаємо 🤓
        </h2>
        <FAQList client:visible data={faqData} />
    </div>
</section>
