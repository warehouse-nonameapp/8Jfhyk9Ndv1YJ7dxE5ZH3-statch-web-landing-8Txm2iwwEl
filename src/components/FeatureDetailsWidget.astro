---
interface Point {
    title: string;
    subtitle: string;
    title_en?: string;
    subtitle_en?: string;
}

interface Props {
    title: string;
    titleEn?: string;
    image: string;
    points: Point[];
    orientation?: "left" | "right";
}

const { title, titleEn, image, points, orientation = "left" } = Astro.props;
---

<div class="flex flex-col gap-[40px] w-full animate-on-scroll">
    {/* Title — full width on top */}
    <h2
        data-uk={title}
        data-en={titleEn || title}
        class="font-['Mulish'] text-[24px] md:text-[32px] font-extrabold leading-[130%] text-[#E0E0E0]"
        style="font-variant-numeric: lining-nums tabular-nums;"
    >
        {title}
    </h2>

    {/* Image + Points row */}
    <div
        class="flex flex-col md:flex-row items-start gap-[40px]"
        style={orientation === "right" ? "flex-direction: row-reverse;" : ""}
    >
        {/* Screenshot */}
        <img
            src={image}
            alt={title}
            style="width: 220px; height: auto; border-radius: 25px; box-shadow: 0 26.4px 110px 0 rgba(82, 112, 250, 0.20); display: block; flex-shrink: 0; align-self: flex-start;"
        />

        {/* Points */}
        <div class="flex flex-col gap-[32px] flex-1">
            {
                points.map((point) => (
                    <div class="flex items-start gap-[24px]">
                        <div
                            class="flex items-center justify-center shrink-0"
                            style="width: 40px; height: 40px; border-radius: 1000px; background: rgba(41, 150, 52, 0.10);"
                        >
                            <img
                                src={import.meta.env.BASE_URL + "assets/ic_green_check.svg"}
                                alt=""
                                style="width: 20px; height: 20px; flex-shrink: 0;"
                            />
                        </div>
                        <div class="flex flex-col gap-[12px]">
                            <h3
                                data-uk={point.title}
                                data-en={point.title_en || point.title}
                                class="font-['Mulish'] text-[18px] leading-[130%] md:text-[24px] font-bold text-[#E0E0E0]"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {point.title}
                            </h3>
                            <p
                                data-uk={point.subtitle}
                                data-en={point.subtitle_en || point.subtitle}
                                class="font-['Mulish'] text-[14px] leading-[150%] md:text-[16px] font-semibold text-[#E0E0E0]"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {point.subtitle}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</div>
