---
interface Props {
    title: string;
    image: string;
    points: { title: string; subtitle: string }[];
    orientation?: "left" | "right";
}

const { title, image, points, orientation = "left" } = Astro.props;
---

<div class="flex flex-col md:flex-row items-start gap-[40px] w-full">
    {/* Text Content */}
    <div
        class:list={[
            "flex flex-col gap-[32px] w-full animate-on-scroll delay-200",
            orientation === "left" ? "md:order-first" : "md:order-last"
        ]}
    >
        {/* Mobile image */}
        <div class="md:hidden flex justify-center w-full mb-2">
            <img
                src={image}
                alt={title}
                class="w-[200px] h-auto block relative z-10"
                style="filter: drop-shadow(0 24px 50px rgba(82, 112, 250, 0.20)); transform: translateZ(0); will-change: filter;"
            />
        </div>

        <h2
            class="self-stretch text-[#e0e0e0] text-[24px] md:text-[32px] font-extrabold leading-[130%] font-sans tabular-nums lining-nums text-left"
        >
            {title}
        </h2>

        <div class="flex flex-col gap-[32px]">
            {
                points.map((point, index) => (
                    <div class="flex items-start gap-[24px]">
                        {/* Numbered Circle */}
                        <div class="relative w-[40px] h-[40px] rounded-full bg-[#1C4FD8]/15 border border-[#1C4FD8]/30 flex items-center justify-center shrink-0">
                            <span class="text-[#7493E5] font-bold text-[16px] leading-none font-sans">
                                {index + 1}
                            </span>
                        </div>

                        <div class="flex flex-col gap-[8px]">
                            <h3 class="text-[#e0e0e0] text-[18px] leading-[23px] md:text-[24px] md:leading-[31px] font-bold font-sans tabular-nums lining-nums">
                                {point.title}
                            </h3>
                            <p class="text-[#e0e0e0] text-[14px] leading-[21px] md:text-[16px] md:leading-[150%] font-semibold font-sans tabular-nums lining-nums opacity-70">
                                {point.subtitle}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    {/* Image Container */}
    <div
        class:list={[
            "hidden md:flex shrink-0 self-start justify-center animate-on-scroll",
            "w-[220px]",
            orientation === "left" ? "md:order-last" : "md:order-first"
        ]}
    >
        <img
            src={image}
            alt={title}
            class="w-[220px] h-auto block relative z-10"
            style="filter: drop-shadow(0 26px 100px rgba(82, 112, 250, 0.20)); transform: translateZ(0); will-change: filter;"
        />
    </div>
</div>
