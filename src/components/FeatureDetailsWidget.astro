---
interface Props {
    title: string;
    image: string;
    points: { title: string; subtitle: string }[];
    orientation?: "left" | "right";
}

const { title, image, points, orientation = "left" } = Astro.props;
---

<div class="flex flex-col md:flex-row items-center gap-8 md:gap-10 w-full">
    {/* Text Content */}
    <div
        class:list={[
            "flex flex-col gap-10 w-full animate-on-scroll delay-200",
            orientation === "left" ? "md:order-first" : "md:order-last"
        ]}
    >
        <div class="md:hidden flex justify-center w-full mb-6">
            <img
                src={image}
                alt={title}
                class="w-[191px] h-auto block relative z-10"
                style="filter: drop-shadow(0 24px 50px rgba(82, 112, 250, 0.20)); transform: translateZ(0); will-change: filter;"
            />
        </div>

        <h2
            class="self-stretch text-[#E0E0E0] text-[24px] md:text-[32px] font-extrabold leading-[130%] tracking-[1px] font-sans tabular-nums lining-nums text-left"
        >
            {title}
        </h2>

        <div class="flex flex-col gap-10">
            {
                points.map((point) => (
                    <div class="flex items-start gap-6">
                        {/* Green Check Icon with Background */}
                        <div class="relative w-[40px] h-[40px] rounded-full bg-[#299634]/10 shrink-0">
                            <img
                                src={
                                    import.meta.env.BASE_URL +
                                    "assets/ic_green_check.svg"
                                }
                                class="absolute w-5 h-5 left-[10px] bottom-[9px]"
                                alt="check"
                            />
                        </div>

                        <div class="flex flex-col gap-3">
                            <h3 class="text-[#E0E0E0] text-[20px] leading-[26px] md:text-[24px] md:leading-[130%] font-bold font-sans tabular-nums lining-nums">
                                {point.title}
                            </h3>
                            <p class="self-stretch text-[#E0E0E0] text-[14px] leading-[21px] md:text-[16px] md:leading-[150%] font-semibold font-sans tabular-nums lining-nums opacity-80">
                                {point.subtitle}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    {/* Image Container */}
    <div
        class:list={[
            "hidden md:block w-[235px] md:w-[293px] shrink-0 self-center animate-on-scroll",
            orientation === "left" ? "md:order-last" : "md:order-first"
        ]}
    >
        <img
            src={image}
            alt={title}
            class="w-full h-auto block relative z-10"
            style="filter: drop-shadow(0 24px 50px rgba(82, 112, 250, 0.20)); transform: translateZ(0); will-change: filter;"
        />
    </div>
</div>
