---
interface Point {
    title: string;
    subtitle: string;
    title_en?: string;
    subtitle_en?: string;
}

interface Props {
    title: string;
    titleEn?: string;
    image: string;
    points: Point[];
    orientation?: "left" | "right";
}

const { title, titleEn, image, points, orientation = "left" } = Astro.props;

const lang = Astro.currentLocale || "uk";
---

<div class="flex flex-col gap-6 md:gap-[40px] w-full animate-on-scroll">
    {/* Title — full width on top */}
    <h2
        class="font-['Mulish'] text-[24px] md:text-[32px] font-extrabold leading-[130%] text-[#E0E0E0]"
        style="font-variant-numeric: lining-nums tabular-nums;"
    >
        {lang === 'en' ? (titleEn || title) : title}
    </h2>

    {/* Image + Points — mobile: points first then image, desktop: side by side per orientation */}
    <div class={`flex flex-col ${orientation === "left" ? "md:flex-row-reverse" : "md:flex-row"} md:items-start gap-12 md:gap-[40px]`}>

        {/* Points — first in DOM so they appear above image on mobile */}
        <div class="flex flex-col gap-6 md:gap-[32px] flex-1">
            {
                points.map((point) => (
                    <div class="flex items-start gap-4 md:gap-[24px]">
                        {/* Circle */}
                        <div
                            class="w-[26px] h-[26px] md:w-10 md:h-10 flex items-center justify-center shrink-0 rounded-full"
                            style="background: rgba(41, 150, 52, 0.10);"
                        >
                            <img
                                src={import.meta.env.BASE_URL + "assets/ic_green_check.svg"}
                                alt=""
                                class="w-3 h-3 md:w-5 md:h-5 shrink-0"
                            />
                        </div>
                        {/* Text */}
                        <div class="flex flex-col gap-2 md:gap-[12px]">
                            <h3
                                class="font-['Mulish'] text-[20px] leading-[130%] md:text-[24px] font-bold text-[#E0E0E0]"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {lang === 'en' ? (point.title_en || point.title) : point.title}
                            </h3>
                            <p
                                class="font-['Mulish'] text-[16px] leading-[150%] md:text-[16px] font-semibold text-[#E0E0E0]"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {lang === 'en' ? (point.subtitle_en || point.subtitle) : point.subtitle}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* Screenshot — last on mobile (48px gap via parent gap-12), side on desktop */}
        <img
            src={image}
            alt={title}
            class="w-[220px] h-auto self-center md:self-start"
            style="border-radius: 25px; box-shadow: 0 26.4px 110px 0 rgba(82, 112, 250, 0.20); display: block; flex-shrink: 0;"
        />
    </div>
</div>
