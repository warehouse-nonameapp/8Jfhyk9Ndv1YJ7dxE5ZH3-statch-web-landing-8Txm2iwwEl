---
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import { useTranslations } from "../i18n/utils";

interface Props {
    hideCTA?: boolean;
}

const currentYear = new Date().getFullYear();
const { hideCTA = false } = Astro.props;

const lang = Astro.currentLocale || "uk";
const t = useTranslations(lang as any);
---

<footer
    id="main-footer"
    class={`bg-gradient-to-b from-[#14161A] to-[#0D0E10] relative z-30 overflow-hidden border-t-2 border-[#2B2F36] ${!hideCTA ? 'rounded-t-[24px] md:rounded-t-[40px] -mt-[24px] md:-mt-[40px]' : ''}`}
>
    <div class="relative z-10 flex flex-col w-full">
        {/* --- Merged CTA Section Container --- */}
        {/* Figma: py-[100px] for this section */}
        {!hideCTA && (
            <div class="relative w-full py-20 md:py-[100px]">
            {
                /* Background Image/Gradient - Positioned at bottom of CTA section */
            }
            <div
                class="absolute inset-x-0 bottom-0 z-0 h-full flex items-end justify-center pointer-events-none"
            >
                <picture class="w-full flex items-end justify-center">
                    <img
                        src={import.meta.env.BASE_URL +
                            "assets/ic_footer_radial_background.webp"}
                        alt=""
                        class="w-full h-auto object-bottom object-cover md:object-contain opacity-60"
                        loading="lazy"
                    />
                </picture>
            </div>

            {/* CTA Content */}
            <div
                class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] w-full"
            >
                <div
                    class="flex flex-col items-start md:items-center text-left md:text-center text-white"
                >
                    <h2
                        class="text-[24px] md:text-[48px] font-extrabold mb-4 md:mb-6 leading-tight animate-on-scroll"
                    >
                        {t("cta_title")}
                    </h2>

                    <p
                        class="text-[14px] md:text-[18px] font-semibold opacity-80 max-w-2xl mb-10 md:mb-12 leading-relaxed animate-on-scroll delay-100"
                    >
                        {t("cta_description")}
                    </p>

                    <div class="w-full md:w-auto origin-center">
                        <BetaSubscriptionButton
                            client:visible
                            className="w-full md:w-auto"
                        />
                    </div>
                </div>
            </div>
        </div>
        )}

        {/* Full Width Divider */}
        {!hideCTA && (
            <div class="w-full h-[1px] bg-white/10 relative z-20"></div>
        )}

        {/* --- Footer Content --- */}
        <div
            class="max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] w-full pt-8 md:pt-[64px] pb-8 md:pb-[80px]"
        >
            <div
                class="flex flex-col md:flex-row items-start md:items-stretch justify-between gap-16 md:gap-24 animate-on-scroll delay-200"
            >
                {/* Left Column: Logo */}
                <div class="flex flex-col justify-between">
                    <div class="flex flex-row items-center gap-4">
                        <img
                            src={import.meta.env.BASE_URL + "assets/ic_statch_icon_footer.svg"}
                            alt="Statch Icon"
                            class="w-10 h-10"
                            loading="lazy"
                        />
                        <img
                            src={import.meta.env.BASE_URL + "assets/ic_statch_name_footer.svg"}
                            alt="Statch"
                            class="h-[35px]"
                            loading="lazy"
                        />
                    </div>
                </div>

                {/* Right Column: Site, Socials, Contacts */}
                <div
                    class="flex flex-col md:flex-row justify-start items-start gap-16 md:gap-24 w-full md:w-auto"
                >
                    {/* Site Column */}
                    <div class="flex flex-col items-start gap-4">
                        <h3
                            class="text-[#4F5161] font-extrabold text-[16px] leading-[150%] md:font-semibold md:text-base"
                            style="font-variant-numeric: lining-nums tabular-nums;"
                        >
                            {t("footer_site")}
                        </h3>
                        <div class="flex flex-col items-start gap-4">
                            <a
                                href={lang === "en" ? "/en" : "/"}
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                                >{t("footer_app")}</a
                            >
                            <a
                                href={lang === "en" ? "/en/terms" : "/terms"}
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                                >{t("footer_terms_use")}</a
                            >
                            <a
                                href={lang === "en" ? "/en/privacy" : "/privacy"}
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                                >{t("footer_privacy")}</a
                            >
                        </div>
                    </div>

                    {/* Socials Column */}
                    <div class="flex flex-col items-start gap-4">
                        <h3
                            class="text-[#4F5161] font-extrabold text-[16px] leading-[150%] md:font-semibold md:text-base"
                            style="font-variant-numeric: lining-nums tabular-nums;"
                        >
                            {t("footer_socials")}
                        </h3>
                        <div class="flex flex-col items-start gap-4">
                            <a
                                href="https://www.threads.net/@statch.squad"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                                >Threads</a
                            >
                            <a
                                href="https://www.instagram.com/statch.squad"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                                >Instagram</a
                            >
                        </div>
                    </div>

                    {/* Contacts Column */}
                    <div class="flex flex-col items-start gap-4">
                        <h3
                            class="text-[#4F5161] font-extrabold text-[16px] leading-[150%] md:font-semibold md:text-base"
                            style="font-variant-numeric: lining-nums tabular-nums;"
                        >
                            {t("footer_contacts")}
                        </h3>
                        <a
                            href="mailto:say.hello@statch.io"
                            class="text-[#E0E0E0] hover:text-[#3E6BE1] font-extrabold text-[16px] leading-[150%] md:font-medium md:text-base transition-colors"
                            style="font-variant-numeric: lining-nums tabular-nums;"
                            >say.hello@statch.io</a
                        >
                    </div>
                </div>
            </div>

            {/* Copyright & Message */}
            <div class="flex flex-col gap-2 mt-10 md:mt-[40px]">
                <p
                    class="text-[#4F5161] font-extrabold text-[16px] leading-[150%] md:font-semibold md:text-base"
                    style="font-variant-numeric: lining-nums tabular-nums;"
                >
                    {t("footer_copyright")}
                </p>
                <p
                    class="text-[#4F5161] font-extrabold text-[16px] leading-[150%] md:font-semibold md:text-base"
                    style="font-variant-numeric: lining-nums tabular-nums;"
                >{t("footer_message")}</p>
            </div>
        </div>

    </div>
</footer>
