---
import { Strings } from "../consts/strings";
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";

interface Props {
    hideCTA?: boolean;
}

const currentYear = new Date().getFullYear();
const { hideCTA = false } = Astro.props;
---

<footer
    class={`bg-gradient-to-b from-[#14161A] to-[#0D0E10] relative z-30 overflow-hidden border-t-2 border-[#2B2F36] ${!hideCTA ? 'rounded-t-[24px] md:rounded-t-[40px] -mt-[24px] md:-mt-[40px]' : ''}`}
>
    <div class="relative z-10 flex flex-col w-full">
        {/* --- Merged CTA Section Container --- */}
        {/* Figma: py-[100px] for this section */}
        {!hideCTA && (
            <div class="relative w-full py-20 md:py-[100px]">
            {
                /* Background Image/Gradient - Positioned at bottom of CTA section */
            }
            <div
                class="absolute inset-x-0 bottom-0 z-0 h-full flex items-end justify-center pointer-events-none"
            >
                <picture class="w-full flex items-end justify-center">
                    <img
                        src={import.meta.env.BASE_URL +
                            "assets/ic_footer_radial_background.webp"}
                        alt=""
                        class="w-full h-auto object-bottom object-cover md:object-contain opacity-60"
                    />
                </picture>
            </div>

            {/* CTA Content */}
            <div
                class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-[200px] w-full"
            >
                <div
                    class="flex flex-col items-start md:items-center text-left md:text-center text-white"
                >
                    <h2
                        class="text-[24px] md:text-[48px] font-extrabold mb-4 md:mb-6 leading-tight animate-on-scroll"
                    >
                        {Strings.cta_title}
                    </h2>

                    <p
                        class="text-[14px] md:text-[18px] font-semibold opacity-80 max-w-2xl mb-10 md:mb-12 leading-relaxed animate-on-scroll delay-100"
                    >
                        {Strings.cta_description}
                    </p>

                    <div class="w-full md:w-auto origin-center">
                        <BetaSubscriptionButton
                            client:visible
                            className="w-full md:w-auto"
                        />
                    </div>
                </div>
            </div>
        </div>
        )}

        {/* Full Width Divider */}
        {!hideCTA && (
            <div class="w-full h-[1px] bg-white/10 relative z-20"></div>
        )}

        {/* --- Footer Content --- */}
        {/* Figma: pt-[64px], pb-[80px] */}
        <div
            class="max-w-[1440px] mx-auto px-6 md:px-[200px] w-full pt-10 md:pt-[64px] pb-[72px] md:pb-[80px]"
        >
            <div
                class="flex flex-col md:flex-row items-stretch justify-between gap-10 md:gap-24 animate-on-scroll delay-200"
            >
                {/* Left Column: Logo & Copyright (Desktop) */}
                <div class="flex flex-col justify-between">
                    <div class="flex flex-row items-center gap-4">
                        <img
                            src={import.meta.env.BASE_URL +
                                "assets/ic_statch_icon_footer.svg"}
                            alt="Statch Icon"
                            class="w-10 h-10"
                        />
                        <img
                            src={import.meta.env.BASE_URL +
                                "assets/ic_statch_name_footer.svg"}
                            alt="Statch"
                            class="h-[35px]"
                        />
                    </div>

                    {/* Desktop Copyright & Message */}
                    <div
                        class="hidden md:flex flex-col gap-2 text-text-gray font-semibold text-sm md:text-base mt-auto"
                    >
                        <p>
                            {
                                Strings.footer_copyright.replace(
                                    "{year}",
                                    currentYear.toString(),
                                )
                            }
                        </p>
                        <p>{Strings.footer_message}</p>
                    </div>
                </div>

                {/* Right Column: Site, Socials, Contacts */}
                <div
                    class="flex flex-col md:flex-row justify-start gap-10 md:gap-24 w-full md:w-auto"
                >
                    {/* Site Column */}
                    <div class="flex flex-col gap-4">
                        <h3
                            class="text-text-gray font-semibold text-sm md:text-base"
                        >
                            {Strings.footer_site_title}
                        </h3>
                        <div class="flex flex-col gap-4">
                            <a
                                href="/beta-test"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                                >{Strings.footer_app}</a
                            >
                            <a
                                href="/beta-test/terms"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                                >{Strings.footer_terms_use}</a
                            >
                            <a
                                href="/beta-test/privacy"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                                >{Strings.footer_privacy}</a
                            >
                        </div>
                    </div>

                    {/* Socials Column */}
                    <div class="flex flex-col gap-4">
                        <h3
                            class="text-text-gray font-semibold text-sm md:text-base"
                        >
                            {Strings.footer_socials_title}
                        </h3>
                        <div class="flex flex-col gap-4">
                            <a
                                href="https://statch.io/threads"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                                >Threads</a
                            >
                            <a
                                href="https://statch.io/instagram"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                                >Instagram</a
                            >
                        </div>
                    </div>

                    {/* Contacts Column */}
                    <div class="flex flex-col gap-4">
                        <h3
                            class="text-text-gray font-semibold text-sm md:text-base"
                        >
                            {Strings.footer_contacts_title}
                        </h3>
                        <a
                            href="mailto:say.hello@statch.io"
                            class="text-[#E0E0E0] hover:text-[#3E6BE1] font-medium text-sm md:text-base transition-colors"
                            >say.hello@statch.io</a
                        >
                    </div>
                </div>

                {/* Mobile Copyright & Message */}
                <div
                    class="flex md:hidden flex-col gap-2 text-text-gray font-semibold text-sm md:text-base"
                >
                    <p>
                        {
                            Strings.footer_copyright.replace(
                                "{year}",
                                currentYear.toString(),
                            )
                        }
                    </p>
                    <p>{Strings.footer_message}</p>
                </div>
            </div>
        </div>

    </div>
</footer>
