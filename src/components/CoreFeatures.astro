---
import BetaTestBanner from "./BetaTestBanner.astro";

const features = [
  {
    icon: import.meta.env.BASE_URL + "assets/ic_lightning.svg",
    title: "Легкий старт",
    description:
      "Неважливо, чи ти лише починаєш продавати, чи вже давно працюєш з обліком — тут усе інтуїтивно. Кілька хвилин, і ти вже в темі.",
    iconBg: "#0F1015",
    color: "#299634",
  },
  {
    icon: import.meta.env.BASE_URL + "assets/ic_shopping_bag.svg",
    title: "Зручний менеджмент замовлень",
    description:
      "Статуси під контролем, історія змін збережена. А ще ти можеш додавати собі нотатки, щоб не забути щось важливе у майбутньому.",
    iconBg: "#0F1015",
    color: "#CFA421",
  },
  {
    icon: import.meta.env.BASE_URL + "assets/ic_package.svg",
    title: "Управління залишками",
    description:
      "Жодного хаосу у товарах та категоріях — усе чітко розкладено по поличках. Або по складах 😉",
    iconBg: "#0F1015",
    color: "#C32A2A",
  },
  {
    icon: import.meta.env.BASE_URL + "assets/ic_cpu.svg",
    title: "Автоматизація",
    description:
      "Імпорт товарів, нагадування про 'забуті' замовлення та товари без продажу. Жодна дрібниця не пройде повз.",
    iconBg: "#0F1015",
    color: "#AB2CB7",
  },
];
---

<section
  class="pt-8 md:pt-[100px] pb-0 text-white relative z-10 -mt-[24px] md:-mt-[40px]"
  style="border-radius: 40px 40px 0 0; background: linear-gradient(180deg, #0D0E10 0%, #161822 100%);"
>
  <div class="max-w-[1200px] mx-auto px-5 md:px-10">
    <div class="text-center mb-[56px] flex flex-col items-center">
      <h2
        class="self-stretch text-[#E0E0E0] text-center text-3xl md:text-[32px] font-extrabold leading-[130%] tracking-[1px] font-sans tabular-nums lining-nums animate-on-scroll"
      >
        Що ще вміє Statch? Зараз розповімо! 😎
      </h2>
      <p
        class="mt-6 self-stretch text-[#E0E0E0] text-center text-sm md:text-base font-semibold leading-[150%] font-sans tabular-nums lining-nums animate-on-scroll delay-100"
      >
        Статуси під контролем, історія змін збережена. А ще ти можеш додавати
        собі нотатки, щоб не забути щось важливе у майбутньому.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {
        features.map((feature) => (
          <div class="relative rounded-[16px] md:rounded-[24px] border-[2px] border-[#1E2130] p-6 pt-7 md:p-[24px_32px_32px_32px] bg-[#171821] overflow-hidden group h-full flex flex-col items-start gap-4 animate-on-scroll delay-200">
            {/* Inner Gradient Background matching FeatureGridCard.kt */}
            <div class="absolute inset-0 bg-gradient-to-bl from-[#1A1A28] to-[#12141E] z-0" />

            <div class="relative z-10 flex gap-4 flex-col items-start h-full self-stretch">
              <div class="w-[72px] h-[72px] rounded-full bg-[#0F1015] flex items-center justify-center shrink-0">
                <img
                  src={feature.icon}
                  alt={feature.title}
                  class="w-6 h-6 shrink-0"
                />
              </div>

              <div class="flex flex-col gap-4 self-stretch">
                <h3 class="text-[#E0E0E0] text-xl md:text-2xl font-bold leading-[130%] font-sans tabular-nums lining-nums">
                  {feature.title}
                </h3>
                <p class="text-[#E0E0E0] text-sm md:text-base font-semibold leading-[150%] font-sans tabular-nums lining-nums opacity-80">
                  {feature.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <BetaTestBanner />
  </div>
</section>
