---
import { getEntry } from "astro:content";
import FeatureDetailsWidget from "./FeatureDetailsWidget.astro";

const featuresEntry = await getEntry("features", "all");
const features = featuresEntry?.data || [];
console.log("Features data:", JSON.stringify(features, null, 2));
---

<section class="bg-[#161822] pt-[140px] pb-20 md:pb-32 relative z-10">
  <div class="max-w-[1200px] mx-auto px-6 md:px-10 flex flex-col gap-[140px]">
    {
      features.map((feature) => (
        // @ts-ignore
        <FeatureDetailsWidget
          title={feature.title}
          image={import.meta.env.BASE_URL + feature.image}
          points={feature.points}
          orientation={feature.orientation}
        />
      ))
    }
  </div>
</section>
