---
import { getEntry } from "astro:content";
import FeatureDetailsWidget from "./FeatureDetailsWidget.astro";
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";

const featuresEntry = await getEntry("features", "all");
const features = featuresEntry?.data || [];
---

<section
    class="relative z-10 -mt-[24px] md:-mt-[40px]"
    style="border-radius: 40px 40px 0 0; background: linear-gradient(180deg, #0D0E10 0%, #161822 100%);"
>
    <div class="max-w-[1440px] mx-auto px-6 md:px-[200px] pt-[80px] md:pt-[100px] flex flex-col gap-[100px] md:gap-[140px]">
        {
            features.map((feature, index) => (
                <>
                    {/* @ts-ignore */}
                    <FeatureDetailsWidget
                        title={feature.title_uk || feature.title}
                        titleEn={feature.title_en || feature.title}
                        image={import.meta.env.BASE_URL.replace(/\/$/, "") + feature.image}
                        points={feature.points}
                        orientation={feature.orientation}
                    />

                    {index === 1 && (
                        <div
                            class="w-full flex flex-col md:flex-row items-center gap-[40px] animate-on-scroll relative overflow-hidden"
                            style="padding: 48px 56px; border-radius: 32px; border: 2px solid #1F1B30; background: linear-gradient(90deg, #17132C 0%, #1E1939 100%);"
                        >
                            <img
                                src={import.meta.env.BASE_URL + "assets/ic_blue_boxes_sign_up_banner.svg"}
                                alt=""
                                aria-hidden="true"
                                class="absolute bottom-0 right-0 pointer-events-none"
                            />
                            {/* Text */}
                            <div class="flex flex-col gap-[16px] flex-1">
                                <h2
                                    data-i18n="banner_title"
                                    class="font-['Mulish'] text-[32px] font-extrabold leading-[130%] text-[#E0E0E0]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    Спробуйте Statch — це безкоштовно
                                </h2>
                                <p
                                    data-i18n="banner_desc"
                                    class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#E0E0E0]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    Забудьте про Excel і складні програми — Statch простіший.
                                </p>
                            </div>

                            {/* Button */}
                            <div class="shrink-0 md:pl-[40px]">
                                <BetaSubscriptionButton client:visible />
                            </div>
                        </div>
                    )}
                </>
            ))
        }
    </div>

    {/* Blue boxes decoration */}
    <div class="max-w-[1440px] mx-auto px-6 md:px-[200px] pt-[64px] pb-[40px]">
        <img
            src={import.meta.env.BASE_URL + "assets/ic_blue_boxes.svg"}
            alt=""
            style="display: flex; height: 188px; flex-direction: column; align-items: flex-start; gap: 7.836px; width: auto;"
        />
    </div>
</section>
