---
interface Props {
    title: string;
    description: string;
    image: string;
    points: string[];
    orientation?: "left" | "right";
}

const { title, description, image, points, orientation = "left" } = Astro.props;
---

<div
    class:list={[
        "relative w-full max-w-[1040px] mx-auto bg-background-card rounded-[24px] flex flex-col md:flex-row items-start animate-on-scroll md:min-h-[480px]",
        orientation === "right" ? "md:flex-row-reverse" : "md:flex-row"
    ]}
>
    {/* Desktop Image Container */}
    <div
        class="hidden md:block w-[293px] shrink-0 relative self-stretch"
    >
        <img 
            src={image} 
            alt={title} 
            class:list={[
                "w-[293px] h-[500px] object-contain absolute bottom-[16px] max-w-none z-10",
                orientation === "right" ? "right-[24px]" : "left-[24px]"
            ]} 
        />
    </div>

    {/* Text Content */}
    <div class:list={[
        "flex flex-col w-full pt-8 pb-8 px-6 md:px-0 md:pt-[40px] md:pb-[16px]",
        orientation === "right" ? "md:pl-[40px] md:pr-[16px]" : "md:pr-[40px] md:pl-[16px]",
    ]}>
        <div class="mb-[16px]">
            <h3
                class="text-[24px] md:text-[32px] font-extrabold text-text-main leading-[130%] tracking-[1px] text-left font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {title}
            </h3>
            <p
                class="text-text-main text-[16px] font-semibold leading-[150%] text-left mt-[16px] font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {description}
            </p>
        </div>

        {/* Mobile Image - Sandwich Layout */}
        <div class="md:hidden w-full -mt-2 mb-4 flex justify-center">
            <img
                src={image}
                alt={title}
                class="w-auto max-w-full max-h-[500px] object-contain relative z-10"
            />
        </div>

        <ul class="space-y-[16px]">
            {
                points.map((point) => (
                    <li class="flex items-center gap-[12px]">
                        <div class="w-[8px] h-[8px] rounded-full shrink-0" style="background: #1C4FD8;" />
                        <span class="text-text-main text-[16px] font-semibold leading-[150%] font-['Mulish'] flex-1" style="font-variant-numeric: lining-nums tabular-nums;">
                            {point}
                        </span>
                    </li>
                ))
            }
        </ul>
    </div>
</div>
