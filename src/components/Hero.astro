---
import Header from "./header/Header.astro";
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import FeatureInfoCard from "./FeatureInfoCard.astro";
import { Strings } from "../consts/strings";

const lessChaosPoints = [
    Strings.less_chaos_point1,
    Strings.less_chaos_point2,
    Strings.less_chaos_point3,
];

const flexibleOrdersPoints = [
    Strings.fast_flexible_point1,
    Strings.fast_flexible_point2,
    Strings.fast_flexible_point3,
];
---

<section class="bg-gradient-light w-full overflow-hidden relative">
    <div class="relative w-full max-w-[1200px] mx-auto px-6 md:px-[40px] pt-[40px] z-50">
        <Header />
    </div>

    <div
        class="max-w-[1200px] mx-auto px-6 md:px-[40px] pt-[64px] pb-[80px] md:pb-[120px] flex flex-col items-center"
    >
        {/* Header Text */}
        <div
            class="text-center w-full mx-auto flex flex-col items-center"
        >
            <h1
                class="w-full text-[32px] leading-[38px] md:text-[48px] md:leading-[64px] font-extrabold text-text-main animate-on-scroll tracking-[1px] font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.header_title}
            </h1>
            <p
                class="text-[14px] leading-[21px] md:text-[16px] md:leading-[24px] text-text-main font-semibold w-full max-w-[770px] text-center mt-[16px] animate-on-scroll delay-100 font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.header_description}
            </p>

            <div class="mt-[48px] animate-on-scroll delay-200">
                <div class="origin-center">
                    <BetaSubscriptionButton client:load />
                </div>
            </div>
        </div>

        {/* Hero Image */}
        <div
            class="w-full max-w-[1000px] mt-[80px] mb-[180px] animate-on-scroll delay-300"
        >
            <picture>
                <source
                    media="(max-width: 768px)"
                    srcset={import.meta.env.BASE_URL +
                        "/assets/ic_app_features_compact.webp"}
                />
                <img
                    src={import.meta.env.BASE_URL +
                        "/assets/ic_app_features.webp"}
                    alt="App Features"
                    class="w-full h-auto"
                />
            </picture>
        </div>

        {/* Feature Cards */}
        <div
            class="w-full space-y-[80px] animate-on-scroll delay-400"
        >
            <FeatureInfoCard
                title={Strings.less_chaos_title}
                description={Strings.less_chaos_description}
                image={import.meta.env.BASE_URL + "/assets/ic_less_chaos.webp"}
                points={lessChaosPoints}
                orientation="left"
            />

            <FeatureInfoCard
                title={Strings.fast_flexible_title}
                description={Strings.fast_flexible_description}
                image={import.meta.env.BASE_URL +
                    "/assets/ic_flexible_orders.svg"}
                points={flexibleOrdersPoints}
                orientation="right"
            />
        </div>
    </div>
</section>
