---
import Header from "./header/Header.astro";
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import PlatformChipsRow from "./header/PlatformChipsRow.astro";
import { Strings } from "../consts/strings";

const featureCards = [
    {
        icon: import.meta.env.BASE_URL + "assets/ic_lightning.svg",
        titleKey: "card_easy_start_title",
        descKey: "card_easy_start_desc",
        titleDefault: "Легкий старт",
        descDefault: "Почати можна за кілька хвилин — без навчання і довгих інструкцій.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_shopping-bag.svg",
        titleKey: "card_orders_title",
        descKey: "card_orders_desc",
        titleDefault: "Продажі і замовлення",
        descDefault: "Додавайте товари в замовлення і фіксуйте продажі в кілька натискань.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_package.svg",
        titleKey: "card_stock_title",
        descKey: "card_stock_desc",
        titleDefault: "Залишки і товари",
        descDefault: "Товари, варіанти, фото, ціни і залишки — все в одному місці.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_bell.svg",
        titleKey: "card_notifications_title",
        descKey: "card_notifications_desc",
        titleDefault: "Нагадування і сповіщення",
        descDefault: "Statch нагадає, якщо товар закінчується або давно не було продажів.",
    },
];

const bigCard1Points = [
    { key: "big_card_1_p1", default: "Видно, що є в наявності" },
    { key: "big_card_1_p2", default: "Вся історія змін зберігається" },
    { key: "big_card_1_p3", default: "Списання і переміщення товарів" },
    { key: "big_card_1_p4", default: "Нічого не загубиться" },
];

const bigCard2Points = [
    { key: "big_card_2_p1", default: "Додавання товарів в замовлення" },
    { key: "big_card_2_p2", default: "Знижки і повернення" },
    { key: "big_card_2_p3", default: "Статуси замовлень" },
    { key: "big_card_2_p4", default: "Історія всіх замовлень" },
];
---

<section class="bg-white w-full overflow-x-hidden relative">
    <div class="relative w-full max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] pt-[40px] z-50">
        <Header />
    </div>

    {/* Hero Text + Button */}
    <div class="max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] pt-[64px] flex flex-col items-center text-center">
        <div class="w-full px-0 md:px-0 lg:px-[80px] xl:px-[120px] flex flex-col items-center text-center">
            <h1
                data-i18n="header_title"
                class="text-[32px] leading-[40px] md:text-[48px] md:leading-[64px] font-extrabold text-[#090924] animate-on-scroll tracking-[0.5px] font-['Mulish'] w-full"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.header_title}
            </h1>
            <p
                data-i18n="header_description"
                class="text-[14px] leading-[21px] md:text-[16px] md:leading-[24px] text-[#090924] font-semibold w-full text-center mt-[16px] animate-on-scroll delay-100 font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.header_description}
            </p>
        </div>

        <div class="mt-[48px] animate-on-scroll delay-200 flex flex-col items-center gap-[12px]">
            <BetaSubscriptionButton client:load />
            <PlatformChipsRow />
        </div>
    </div>

    {/* App Screenshot */}
    <div class="w-full flex justify-center mb-[60px] xl:mb-[120px] animate-on-scroll delay-300">
        <img
            src={import.meta.env.BASE_URL + "assets/ic_app_features.png"}
            alt="App Features"
            width="1040"
            height="655.802"
            draggable="false"
            style="aspect-ratio: 157/99; width: 100%; max-width: 1040px; height: auto; user-select: none; -webkit-user-drag: none;"
        />
    </div>

    {/* Feature Cards Section */}
    <div class="max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] pb-[100px]">
        <div class="flex flex-col items-center text-center px-0 md:px-[120px] mb-[40px] md:mb-[48px] animate-on-scroll">
            <h2
                data-i18n="features_section_title"
                class="text-[24px] leading-[31px] md:text-[32px] md:leading-[42px] font-extrabold text-[#090924] font-['Mulish'] w-full"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.features_section_title}
            </h2>
            <p
                data-i18n="features_section_subtitle"
                class="text-[14px] leading-[21px] md:text-[16px] md:leading-[24px] text-[#090924] font-semibold mt-[16px] font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {Strings.features_section_subtitle}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
            {
                featureCards.map((card) => (
                    <div
                        class="flex flex-col items-start gap-[16px] rounded-[24px] bg-[#F5F7FC] animate-on-scroll delay-100"
                        style="padding: 24px 32px 32px 32px; flex: 1 0 0; align-self: stretch;"
                    >
                        {/* Icon circle */}
                        <div
                            class="flex items-center justify-center shrink-0"
                            style="width: 64px; height: 64px; border-radius: 1000px; background: #FFF; gap: 8px;"
                        >
                            <img
                                src={card.icon}
                                alt={card.titleDefault}
                                style="width: 24px; height: 24px; flex-shrink: 0;"
                            />
                        </div>

                        {/* Title + Subtitle */}
                        <div class="flex flex-col gap-[12px] w-full">
                            <h3
                                data-i18n={card.titleKey}
                                class="text-[24px] leading-[130%] font-bold text-[#090924] font-['Mulish']"
                                style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                            >
                                {card.titleDefault}
                            </h3>
                            <p
                                data-i18n={card.descKey}
                                class="text-[16px] leading-[150%] font-semibold text-[#090924] font-['Mulish']"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {card.descDefault}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* Big Feature Cards */}
        <div class="flex flex-col gap-[60px] mt-[60px] xl:gap-[120px] xl:mt-[120px]">

            {/* Card 1: Product History */}
            <div
                class="flex items-end gap-[16px] rounded-[24px] bg-[#F5F7FC] animate-on-scroll w-full overflow-hidden"
                style="max-width: 1040px;"
            >
                {/* Screenshot */}
                <div class="flex items-end shrink-0 pb-4 pr-4 pl-6">
                    <img
                        src={import.meta.env.BASE_URL + "assets/ic_product_history.png"}
                        alt="Product History"
                        draggable="false"
                        class="md:h-[300px] lg:h-[380px] xl:h-[479px] w-auto object-contain"
                        style="user-select: none; -webkit-user-drag: none;"
                    />
                </div>

                {/* Text */}
                <div class="flex flex-col flex-1 self-stretch pt-8 pr-8 pb-4 pl-0 xl:pt-[40px] xl:pr-[48px] xl:pb-4">
                    <h2
                        data-i18n="big_card_1_title"
                        class="font-['Mulish'] text-[32px] font-[800] leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch; font-weight: 800;"
                    >
                        Всі товари і залишки під контролем
                    </h2>
                    <p
                        data-i18n="big_card_1_desc"
                        class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-[12px] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                    >
                        Додавайте товари, змінюйте кількість, списуйте або переміщуйте між складами — вся історія зберігається.
                    </p>
                    <div class="flex flex-col mt-[24px]" style="gap: 16px;">
                        {bigCard1Points.map((item) => (
                            <div class="flex items-center gap-[12px]">
                                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(28, 79, 216, 0.20));">
                                    <circle cx="4" cy="4" r="4" fill="#1C4FD8"/>
                                </svg>
                                <span
                                    data-i18n={item.key}
                                    class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    {item.default}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            {/* Card 2: Orders */}
            <div
                class="flex items-end gap-[16px] rounded-[24px] bg-[#F5F7FC] animate-on-scroll w-full overflow-hidden"
                style="max-width: 1040px;"
            >
                {/* Text */}
                <div class="flex flex-col flex-1 self-stretch pt-8 pr-0 pb-4 pl-8 xl:pt-[40px] xl:pb-4 xl:pl-[48px]">
                    <h2
                        data-i18n="big_card_2_title"
                        class="font-['Mulish'] text-[32px] leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch; font-weight: 800;"
                    >
                        Всі замовлення в одному місці
                    </h2>
                    <p
                        data-i18n="big_card_2_desc"
                        class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-[12px] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                    >
                        Створюйте замовлення, додавайте товари, застосовуйте знижки і змінюйте статус — все в одному екрані.
                    </p>
                    <div class="flex flex-col mt-[24px]" style="gap: 16px;">
                        {bigCard2Points.map((item) => (
                            <div class="flex items-center gap-[12px]">
                                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(28, 79, 216, 0.20));">
                                    <circle cx="4" cy="4" r="4" fill="#1C4FD8"/>
                                </svg>
                                <span
                                    data-i18n={item.key}
                                    class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    {item.default}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>

                {/* Screenshot */}
                <div class="flex items-end shrink-0 pb-4 pl-4 pr-6">
                    <img
                        src={import.meta.env.BASE_URL + "assets/ic_order_details.png"}
                        alt="Order Details"
                        draggable="false"
                        class="md:h-[300px] lg:h-[380px] xl:h-[479px] w-auto object-contain"
                        style="user-select: none; -webkit-user-drag: none;"
                    />
                </div>
            </div>

        </div>
    </div>

    {/* Boxes decorative image */}
    <div class="relative z-0 max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] mt-[40px] pb-[40px]">
        <img
            src={import.meta.env.BASE_URL + "assets/boxes.svg"}
            alt=""
            draggable="false"
            style="display: block; max-width: min(561px, 100%); height: auto; user-select: none; -webkit-user-drag: none;"
        />
    </div>
</section>
