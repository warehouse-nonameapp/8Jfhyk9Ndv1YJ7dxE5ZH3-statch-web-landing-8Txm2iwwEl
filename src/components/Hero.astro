---
import Header from "./header/Header.astro";
import { BetaSubscriptionButton } from "./islands/BetaSubscriptionButton";
import PlatformChipsRow from "./header/PlatformChipsRow.astro";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || "uk";
const t = useTranslations(lang as any);

const featureCards = [
    {
        icon: import.meta.env.BASE_URL + "assets/ic_lightning.svg",
        titleKey: "card_easy_start_title",
        descKey: "card_easy_start_desc",
        titleDefault: "Легкий старт",
        descDefault: "Жодних інструкцій — реєструєтесь і починаєте працювати за кілька хвилин.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_shopping-bag.svg",
        titleKey: "card_orders_title",
        descKey: "card_orders_desc",
        titleDefault: "Продажі і замовлення",
        descDefault: "Додавайте товари в замовлення і фіксуйте продажі в кілька кліків.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_package.svg",
        titleKey: "card_stock_title",
        descKey: "card_stock_desc",
        titleDefault: "Залишки і товари",
        descDefault: "Назви, фото, варіанти, ціни та залишки — все організовано і під рукою.",
    },
    {
        icon: import.meta.env.BASE_URL + "assets/ic_bell.svg",
        titleKey: "card_notifications_title",
        descKey: "card_notifications_desc",
        titleDefault: "Нагадування і сповіщення",
        descDefault: "Statch нагадає про замовлення, що зависло, або товар без продажів — інтервал налаштовуєте самі.",
    },
];

const bigCard1Points = [
    { key: "big_card_1_p1", default: "Актуальні залишки в реальному часі" },
    { key: "big_card_1_p2", default: "Повна історія кожного товару" },
    { key: "big_card_1_p3", default: "Списання та переміщення між складами" },
    { key: "big_card_1_p4", default: "Жодна зміна не загубиться" },
];

const bigCard2Points = [
    { key: "big_card_2_p1", default: "Деталі замовлення на одному екрані" },
    { key: "big_card_2_p2", default: "Знижки, повернення і коментарі" },
    { key: "big_card_2_p3", default: "Дохід видно одразу" },
    { key: "big_card_2_p4", default: "Статуси і повна історія" },
];
---

<section class="bg-white w-full overflow-x-hidden relative">
    <div class="relative w-full max-w-[1440px] mx-auto px-5 md:px-[80px] lg:px-[140px] xl:px-[200px] pt-8 md:pt-[40px] z-50">
        <Header />
    </div>

    {/* Hero Text + Button */}
    <div class="max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] pt-20 md:pt-[64px] flex flex-col items-center text-center">
        <div class="w-full px-0 md:px-0 lg:px-[80px] xl:px-[120px] flex flex-col items-center text-center">
            <h1
                class="text-[32px] leading-[120%] md:text-[48px] md:leading-[64px] font-extrabold text-[#090924] animate-on-scroll tracking-[0.5px] font-['Mulish'] w-full"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {t("header_title")}
            </h1>
            <p
                class="text-[16px] leading-[150%] md:text-[16px] md:leading-[24px] text-[#090924] font-semibold w-full text-center mt-6 md:mt-[16px] animate-on-scroll delay-100 font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {t("header_description")}
            </p>
        </div>

        <div id="hero-cta-anchor" class="mt-10 md:mt-[48px] animate-on-scroll delay-200 flex flex-col items-center gap-[12px]">
            <BetaSubscriptionButton client:load />
            <PlatformChipsRow />
        </div>
    </div>

    {/* App Screenshot */}
    <div class="w-full flex justify-center px-5 md:px-0 mt-16 md:mt-0 mb-10 md:mb-[60px] xl:mb-[120px] animate-on-scroll delay-300">
        {/* Mobile image */}
        <img
            src={import.meta.env.BASE_URL + "assets/ic_app_features_mobile.webp"}
            alt="App Features"
            draggable="false"
            class="block md:hidden w-full h-auto"
            style="user-select: none; -webkit-user-drag: none;"
        />
        {/* Desktop image */}
        <img
            src={import.meta.env.BASE_URL + "assets/ic_app_features.webp"}
            alt="App Features"
            width="1040"
            height="655.802"
            draggable="false"
            class="hidden md:block"
            style="aspect-ratio: 157/99; width: 100%; max-width: 1040px; height: auto; user-select: none; -webkit-user-drag: none;"
        />
    </div>

    {/* Feature Cards Section */}
    <div class="max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] pb-[100px]">
        <div class="flex flex-col items-center text-center px-0 md:px-[120px] mb-[40px] md:mb-[48px] animate-on-scroll">
            <h2
                class="text-[24px] leading-[130%] md:text-[32px] md:leading-[42px] font-extrabold text-[#090924] font-['Mulish'] w-full"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {t("features_section_title")}
            </h2>
            <p
                class="text-[16px] leading-[150%] md:text-[16px] md:leading-[24px] text-[#090924] font-semibold mt-4 md:mt-[16px] font-['Mulish']"
                style="font-variant-numeric: lining-nums tabular-nums;"
            >
                {t("features_section_subtitle")}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-[24px]">
            {
                featureCards.map((card) => (
                    <div
                        class="flex flex-col items-start gap-3 md:gap-[16px] rounded-[24px] bg-[#F5F7FC] animate-on-scroll delay-100 p-6 md:pt-6 md:px-8 md:pb-8 self-stretch"
                        style="flex: 1 0 0;"
                    >
                        {/* Icon circle */}
                        <div class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center shrink-0 rounded-full bg-white">
                            <img
                                src={card.icon}
                                alt={card.titleDefault}
                                class="w-5 h-5 md:w-6 md:h-6 shrink-0"
                            />
                        </div>

                        {/* Title + Subtitle */}
                        <div class="flex flex-col gap-3 md:gap-[12px] w-full">
                            <h3
                                class="text-[20px] leading-[130%] font-bold md:text-[24px] text-[#090924] font-['Mulish']"
                                style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                            >
                                {t(card.titleKey as any)}
                            </h3>
                            <p
                                class="text-[16px] leading-[150%] font-semibold text-[#090924] font-['Mulish']"
                                style="font-variant-numeric: lining-nums tabular-nums;"
                            >
                                {t(card.descKey as any)}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* Big Feature Cards */}
        <div class="flex flex-col gap-[60px] mt-[60px] xl:gap-[120px] xl:mt-[120px]">

            {/* Card 1: Product History */}
            <div
                class="flex flex-col md:flex-row md:items-start gap-0 md:gap-[16px] rounded-[24px] bg-[#F7F8FA] md:bg-[#F5F7FC] animate-on-scroll w-full p-6 md:p-0"
                style="max-width: 1040px;"
            >
                {/* Mobile: Title + Subtitle */}
                <div class="flex flex-col w-full md:hidden">
                    <h2
                        class="font-['Mulish'] text-[24px] font-extrabold leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums;"
                    >
                        {t("big_card_1_title")}
                    </h2>
                    <p
                        class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-4 w-full"
                        style="font-variant-numeric: lining-nums tabular-nums;"
                    >
                        {t("big_card_1_desc")}
                    </p>
                </div>

                {/* Screenshot */}
                <div class="w-full md:w-auto shrink-0 flex items-center justify-center mt-10 md:-mt-4 px-[34px] pb-[34px] md:px-0 md:pb-4 md:pr-4 md:pl-6">
                    <img
                        src={import.meta.env.BASE_URL + "assets/ic_product_history.png"}
                        alt="Product History"
                        draggable="false"
                        class="w-full h-auto md:w-auto md:h-[300px] lg:h-[380px] xl:h-[479px] object-contain"
                        style="user-select: none; -webkit-user-drag: none;"
                    />
                </div>

                {/* Desktop: Title + Subtitle + Bullets / Mobile: Bullets only */}
                <div class="flex flex-col flex-1 self-stretch mt-10 md:mt-0 md:pt-8 md:pr-8 md:pb-4 md:pl-0 xl:pt-[40px] xl:pr-[48px] xl:pb-4">
                    <h2
                        class="hidden md:block font-['Mulish'] text-[32px] font-[800] leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch; font-weight: 800;"
                    >
                        {t("big_card_1_title")}
                    </h2>
                    <p
                        class="hidden md:block font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-[12px] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                    >
                        {t("big_card_1_desc")}
                    </p>
                    <div class="flex flex-col md:mt-[24px]" style="gap: 16px;">
                        {bigCard1Points.map((item) => (
                            <div class="flex items-center gap-[12px]">
                                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(28, 79, 216, 0.20));">
                                    <circle cx="4" cy="4" r="4" fill="#1C4FD8"/>
                                </svg>
                                <span
                                    class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    {t(item.key as any)}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            {/* Card 2: Orders */}
            {/* md:flex-row-reverse so on desktop text appears left, image right */}
            <div
                class="flex flex-col md:flex-row-reverse md:items-start gap-0 md:gap-[16px] rounded-[24px] bg-[#F7F8FA] md:bg-[#F5F7FC] animate-on-scroll w-full p-6 md:p-0"
                style="max-width: 1040px;"
            >
                {/* Mobile: Title + Subtitle */}
                <div class="flex flex-col w-full md:hidden">
                    <h2
                        class="font-['Mulish'] text-[24px] font-extrabold leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums;"
                    >
                        {t("big_card_2_title")}
                    </h2>
                    <p
                        class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-4 w-full"
                        style="font-variant-numeric: lining-nums tabular-nums;"
                    >
                        {t("big_card_2_desc")}
                    </p>
                </div>

                {/* Screenshot */}
                <div class="w-full md:w-auto shrink-0 flex items-center justify-center mt-10 md:-mt-4 px-[34px] pb-[34px] md:px-0 md:pb-4 md:pl-4 md:pr-6">
                    <img
                        src={import.meta.env.BASE_URL + "assets/ic_order_details.png"}
                        alt="Order Details"
                        draggable="false"
                        class="w-full h-auto md:w-auto md:h-[300px] lg:h-[380px] xl:h-[479px] object-contain"
                        style="user-select: none; -webkit-user-drag: none;"
                    />
                </div>

                {/* Desktop: Title + Subtitle + Bullets / Mobile: Bullets only */}
                <div class="flex flex-col flex-1 self-stretch mt-10 md:mt-0 md:pt-8 md:pr-0 md:pb-4 md:pl-8 xl:pt-[40px] xl:pb-4 xl:pl-[48px]">
                    <h2
                        class="hidden md:block font-['Mulish'] text-[32px] leading-[130%] text-[#090924] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch; font-weight: 800;"
                    >
                        {t("big_card_2_title")}
                    </h2>
                    <p
                        class="hidden md:block font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924] mt-[12px] w-full"
                        style="font-variant-numeric: lining-nums tabular-nums; align-self: stretch;"
                    >
                        {t("big_card_2_desc")}
                    </p>
                    <div class="flex flex-col md:mt-[24px]" style="gap: 16px;">
                        {bigCard2Points.map((item) => (
                            <div class="flex items-center gap-[12px]">
                                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(28, 79, 216, 0.20));">
                                    <circle cx="4" cy="4" r="4" fill="#1C4FD8"/>
                                </svg>
                                <span
                                    class="font-['Mulish'] text-[16px] font-semibold leading-[150%] text-[#090924]"
                                    style="font-variant-numeric: lining-nums tabular-nums;"
                                >
                                    {t(item.key as any)}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

        </div>
    </div>

    {/* Boxes decorative image */}
    <div class="hidden md:block relative z-0 max-w-[1440px] mx-auto px-6 md:px-[80px] lg:px-[140px] xl:px-[200px] mt-[40px] pb-[40px]">
        <img
            src={import.meta.env.BASE_URL + "assets/boxes.svg"}
            alt=""
            draggable="false"
            style="display: block; max-width: min(561px, 100%); height: auto; user-select: none; -webkit-user-drag: none;"
        />
    </div>
</section>
