---
import Layout from "../layouts/Layout.astro";
import AppLogo from "../components/header/AppLogo.astro";
---

<Layout titleEn="Statch | Something went wrong" titleUk="Statch | Щось пішло не так">
	<main class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden bg-gradient-light px-4">
		<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary opacity-5 rounded-full blur-[120px] animate-pulse-glow"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-error opacity-[0.03] rounded-full blur-[120px] animate-pulse-glow delay-500"></div>

		<div class="z-10 flex flex-col items-center text-center max-w-2xl animate-on-scroll">
			<div class="mb-12 scale-125">
				<AppLogo />
			</div>
			
			<div class="text-[120px] leading-none font-extrabold text-primary opacity-20 mb-4 tracking-tighter">500</div>

			<h1 class="text-3xl md:text-5xl font-extrabold text-text-main mb-6 tracking-tight leading-tight" data-i18n="error_500_title">
				Something went wrong
			</h1>
			
			<p class="text-lg md:text-xl text-text-gray mb-10 leading-relaxed max-w-lg mx-auto" data-i18n="error_500_desc">
				We're already working on fixing the issue. Please try again later.
			</p>

			<a href="/" class="px-8 py-4 bg-primary text-white font-bold rounded-2xl shadow-xl shadow-primary/20 hover:scale-105 transition-transform active:scale-95 text-center">
				<span data-i18n="back_to_home">Back to home</span>
			</a>
		</div>
	</main>
</Layout>
