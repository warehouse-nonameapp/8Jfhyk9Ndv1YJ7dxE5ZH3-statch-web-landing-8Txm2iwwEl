---
import Layout from "../layouts/Layout.astro";
import AppLogo from "../components/header/AppLogo.astro";
---

<Layout title="Statch | Coming Soon">
	<main class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden bg-gradient-light px-4">
		{/* Animated Background Elements */}
		<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary opacity-5 rounded-full blur-[120px] animate-pulse-glow"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-primary opacity-10 rounded-full blur-[120px] animate-pulse-glow delay-500"></div>

		<div class="z-10 flex flex-col items-center text-center max-w-2xl animate-on-scroll">
			<div class="mb-12 scale-125">
				<AppLogo />
			</div>
			
			<h1 class="text-4xl md:text-6xl font-extrabold text-text-main mb-6 tracking-tight leading-tight">
				Something <span class="text-primary italic">Big</span> is<br/>Coming Soon
			</h1>
			
			<p class="text-lg md:text-xl text-text-gray mb-10 leading-relaxed max-w-lg mx-auto">
				We're building a smarter way to manage your inventory. 
				Statch is almost ready to turn your chaos into control.
			</p>

			<div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
				<a href="mailto:hello@statch.io" class="px-8 py-4 bg-primary text-white font-bold rounded-2xl shadow-xl shadow-primary/20 hover:scale-105 transition-transform active:scale-95 text-center">
					Contact Us
				</a>
				<a href="/beta-test" class="px-8 py-4 bg-white text-primary border-2 border-primary/10 font-bold rounded-2xl hover:bg-primary/5 transition-colors text-center">
					Preview Beta
				</a>
			</div>
		</div>

		<div class="absolute bottom-10 text-text-light text-sm font-medium animate-on-scroll delay-300">
			&copy; {new Date().getFullYear()} Statch. All rights reserved.
		</div>
	</main>
</Layout>

<style>
	main {
		background: radial-gradient(circle at center, #F2F6FF 0%, #FFFFFF 100%);
	}
	
	/* Glassmorphism subtle effect for the content if needed */
	/* .content-card {
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.2);
	} */
</style>
