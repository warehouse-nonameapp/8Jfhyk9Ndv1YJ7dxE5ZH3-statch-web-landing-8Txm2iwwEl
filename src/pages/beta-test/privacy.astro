    <div class="component-footer">
        <Footer hideCTA={true} />
    </div>
    
    <script>
        if (typeof window !== 'undefined') {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('layout') === 'contentOnly') {
                document.documentElement.classList.add('layout-content-only');
            }
        }
        
        const sections = document.querySelectorAll<HTMLElement>('section[id]');
        const navLinks = document.querySelectorAll<HTMLElement>('.terms-link');
        let currentActiveId: string | null = null;

        const updateActiveLink = () => {
            if (sections.length === 0) return;
            let sectionId: string | null = sections[0].getAttribute('id');
            const scrollPos = window.scrollY + window.innerHeight * 0.3;

            sections.forEach(sec => {
                const rect = sec.getBoundingClientRect();
                const absoluteTop = rect.top + window.scrollY;
                if (absoluteTop <= scrollPos) {
                    sectionId = sec.getAttribute('id');
                }
            });

            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
                sectionId = sections[sections.length - 1].getAttribute('id');
            }

            if (currentActiveId !== sectionId) {
                currentActiveId = sectionId;
                navLinks.forEach(link => {
                    const num = link.querySelector('.terms-num');
                    const label = link.querySelector('.terms-label');
                    
                    num?.classList.remove('text-[#090924]');
                    num?.classList.add('text-[#A6A6BC]');
                    label?.classList.remove('text-[#090924]');
                    label?.classList.add('text-[#A6A6BC]');
                    
                    if (link.getAttribute('href') === `#${sectionId}`) {
                        num?.classList.remove('text-[#A6A6BC]');
                        num?.classList.add('text-[#090924]');
                        label?.classList.remove('text-[#A6A6BC]');
                        label?.classList.add('text-[#090924]');
                    }
                });
            }
        };

        window.addEventListener('scroll', updateActiveLink, { passive: true });
        window.addEventListener('resize', updateActiveLink, { passive: true });
        updateActiveLink();
    </script>

    <style is:global>
        html.layout-content-only .component-header,
        html.layout-content-only .component-footer,
        html.layout-content-only .component-back-btn {
            display: none !important;
        }
        
        html.layout-content-only .component-heading {
            margin-top: 1rem !important;
        }

        html.layout-content-only main {
            padding-top: 1rem !important;
            margin-top: 0 !important;
        }
    </style>
</Layout>
