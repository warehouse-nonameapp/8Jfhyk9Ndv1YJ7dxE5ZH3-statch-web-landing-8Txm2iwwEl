---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import FeaturesList from "../../components/FeaturesList.astro";
import FAQSection from "../../components/FAQSection.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
import { FloatingFooter } from "../../components/islands/FloatingFooter";
---

<Layout
    titleUk="Statch | Простий облік товарів для малого бізнесу"
    titleEn="Statch | Simple Inventory for Small Business"
    ogTitleUk="Statch — Простий облік товарів для малого бізнесу"
    ogTitleEn="Statch — Simple Inventory for Small Business"
    ogDescriptionUk="Додавайте товари, фіксуйте продажі, стежте за залишками — Statch сам порахує прибуток. Спробуйте безкоштовно."
    ogDescriptionEn="Add products, record sales, track stock levels — Statch calculates your profit automatically. Try it free."
>
    <main class="w-full relative">
        <Hero />
        <FeaturesList />
        <FAQSection />
        <CTA />
        <Footer hideCTA={true} />

        {/* Mobile Floating Footer */}
        <FloatingFooter client:load />
    </main>
</Layout>
