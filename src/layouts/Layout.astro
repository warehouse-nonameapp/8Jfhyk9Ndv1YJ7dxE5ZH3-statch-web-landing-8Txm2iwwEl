---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
	title?: string;
	titleUk?: string;
	titleEn?: string;
	description?: string;
	ogTitleUk?: string;
	ogTitleEn?: string;
	ogDescriptionUk?: string;
	ogDescriptionEn?: string;
	ogImage?: string;
}

const {
	title = "Statch | Less Chaos, More Control",
	titleUk,
	titleEn,
	description = "Statch helps you manage your business with less chaos.",
	ogTitleUk,
	ogTitleEn,
	ogDescriptionUk,
	ogDescriptionEn,
	ogImage = "/og-image.png",
} = Astro.props;

const lang = Astro.currentLocale || 'uk';
const resolvedTitle = lang === 'en' ? (titleEn || title) : (titleUk || title);
const resolvedOgTitle = lang === 'en' ? (ogTitleEn || resolvedTitle) : (ogTitleUk || resolvedTitle);
const resolvedOgDesc = lang === 'en' ? (ogDescriptionEn || description) : (ogDescriptionUk || description);
const resolvedOgImage = ogImage.startsWith("http") ? ogImage : "https://statch.io" + ogImage;

const currentUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const alternateLang = lang === 'uk' ? 'en' : 'uk';
const alternateUrl = new URL(Astro.url.pathname, Astro.url.origin);
if (lang === 'uk') {
	alternateUrl.pathname = `/en${alternateUrl.pathname === '/' ? '' : alternateUrl.pathname}`;
} else {
	alternateUrl.pathname = alternateUrl.pathname.replace(/^\/en/, '') || '/';
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preload" href="/fonts/mulish-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/mulish-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/mulish-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/mulish-cyrillic-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/mulish-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/mulish-cyrillic-800-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
		<link rel="icon" type="image/png" sizes="32x32" href={import.meta.env.BASE_URL + "favicon-32x32.png"} />
		<link rel="icon" type="image/png" sizes="16x16" href={import.meta.env.BASE_URL + "favicon-16x16.png"} />
		<link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + "apple-touch-icon.png"} />
		<link rel="manifest" href={import.meta.env.BASE_URL + "site.webmanifest"} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={resolvedOgDesc} />
		<title>{resolvedTitle}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={"https://statch.io" + Astro.url.pathname} />
		<meta property="og:site_name" content="Statch" />
		<meta id="og-title" property="og:title" content={resolvedOgTitle} />
		<meta id="og-description" property="og:description" content={resolvedOgDesc} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta id="twitter-title" name="twitter:title" content={resolvedOgTitle} />
		<meta id="twitter-description" name="twitter:description" content={resolvedOgDesc} />
		<meta name="twitter:image" content={resolvedOgImage} />

		<!-- SEO Metadata -->
		<link rel="canonical" href={currentUrl} />
		<link rel="alternate" hreflang={lang} href={currentUrl} />
		<link rel="alternate" hreflang={alternateLang} href={alternateUrl.toString()} />
		<link rel="alternate" hreflang="x-default" href={lang === 'uk' ? currentUrl : alternateUrl.toString()} />
		<meta name="theme-color" content="#2054E1" />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Statch",
			"operatingSystem": "Android, iOS, Web",
			"applicationCategory": "BusinessApplication",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			}
		})} />

	</head>
	<body>
		<slot />
		<CookieConsent />



		<style is:global>
			img {
				-webkit-user-select: none;
				user-select: none;
				-webkit-user-drag: none;
				draggable: false;
			}
			/* Animation Base State */
			.animate-on-scroll {
				opacity: 0;
				transform: translateY(20px);
				transition:
					opacity 0.6s ease-out,
					transform 0.6s ease-out;
				backface-visibility: hidden;
				-webkit-backface-visibility: hidden;
			}

			/* Visible State */
			.animate-on-scroll.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Stagger Delays */
			.delay-100 {
				transition-delay: 100ms;
			}
			.delay-200 {
				transition-delay: 200ms;
			}
			.delay-300 {
				transition-delay: 300ms;
			}
			.delay-400 {
				transition-delay: 400ms;
			}
			.delay-400 {
				transition-delay: 400ms;
			}
			.delay-500 {
				transition-delay: 500ms;
			}

			/* Advanced Animations */
			@keyframes float {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-10px);
				}
			}
			.animate-float {
				animation: float 4s ease-in-out infinite;
			}

			@keyframes wiggle {
				0%,
				100% {
					transform: rotate(-3deg);
				}
				50% {
					transform: rotate(3deg);
				}
			}
			.animate-wiggle:hover {
				animation: wiggle 0.5s ease-in-out infinite;
			}

			@keyframes pulse-glow {
				0%,
				100% {
					transform: scale(1);
					filter: drop-shadow(0 0 0 rgba(62, 107, 225, 0));
				}
				50% {
					transform: scale(1.05);
					filter: drop-shadow(0 0 15px rgba(62, 107, 225, 0.4));
				}
			}
			.animate-pulse-glow {
				animation: pulse-glow 3s ease-in-out infinite;
			}
		</style>

		<script>
			const observerOptions = {
				root: null,
				rootMargin: "0px",
				threshold: 0.1,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target); // Only animate once
					}
				});
			}, observerOptions);

			const animateElements =
				document.querySelectorAll(".animate-on-scroll");
			animateElements.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
